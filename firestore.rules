rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }
    function vinculo() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.vinculo;
    }

    match /obras/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && perfil() == 'gerente';
      allow update: if request.auth != null && (
        perfil() == 'gerente' ||
        perfil() == 'genesis' ||
        perfil() == 'estagiario' ||
        (perfil() == 'empreiteira' && resource.data.empreiteira == vinculo()) ||
        (perfil() == 'fiscal' && resource.data.fiscal == vinculo()) ||
        // fiscal_adm: pode atualizar campos de fiscalização/medição em QUALQUER obra
        (perfil() == 'fiscal_adm' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fiscalizacao','pendencia','tiposPendencia','prazoPendencia','dataPendencia',
                      'pendenciaResolvida','regularizacaoData','medicao','medida70','medida230',
                      'medida280','medida280Motivo','cienFisc','cienMed','cienMed280',
                      'cadastroConfirmado','locaisTrabalho','pendenciaDevolvida',
                      'pendenciaDevolvidaEm','enquadramento','favorito','favoritoNota',
                      'atualizadaEm'])) ||
        (perfil() == 'fiscal_adm' && resource.data.fiscal == vinculo()) ||
        // Qualquer fiscal pode atualizar medidas e cientes de qualquer obra
        ((perfil() == 'fiscal' || perfil() == 'fiscal_adm') &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['medida70','medida230','medida280','medida280Motivo',
                      'cienFisc','cienMed','cienMed280','atualizadaEm']))
      );
      allow delete: if request.auth != null && perfil() == 'gerente';
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || perfil() == 'gerente');
      // Usuário pode atualizar seus próprios favoritos
      allow write: if request.auth != null && (perfil() == 'gerente' || request.auth.uid == uid);
    }

    match /empreiteiras/{id} {
      allow read: if request.auth != null;
      // Usuário pode atualizar seus próprios favoritos
      allow write: if request.auth != null && (perfil() == 'gerente' || request.auth.uid == uid);
    }

    match /notificacoes/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
