rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }
    function vinculo() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.vinculo;
    }

    match /obras/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (perfil() == 'gerente' || perfil() == 'adm_odi');
      allow update: if request.auth != null && (
        perfil() == 'gerente' ||
        perfil() == 'adm_odi' ||
        perfil() == 'genesis' ||
        perfil() == 'estagiario' ||
        (perfil() == 'empreiteira' && resource.data.empreiteira == vinculo()) ||
        perfil() == 'fiscal' ||  // fiscal can update obras (app layer controls access)
        // fiscal_adm: acesso completo de escrita (perfil administrativo)
        perfil() == 'fiscal_adm' ||
        // Qualquer fiscal pode atualizar medidas e cientes de qualquer obra
        ((perfil() == 'fiscal' || perfil() == 'fiscal_adm') &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['medida70','medida230','medida280','medida280Motivo',
                      'cienFisc','cienMed','cienMed280','atualizadaEm']))
      );
      allow delete: if request.auth != null && perfil() == 'gerente';
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || perfil() == 'gerente');
      // uid check FIRST to avoid perfil() call failing on own-document updates
      allow write: if request.auth != null && (request.auth.uid == uid || perfil() == 'gerente');
    }

    match /empreiteiras/{id} {
      allow read: if request.auth != null;
      // uid check FIRST to avoid perfil() call failing on own-document updates
      allow write: if request.auth != null && (request.auth.uid == uid || perfil() == 'gerente');
    }

    match /notificacoes/{id} {
      allow read, write: if request.auth != null;
    }
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && perfil() == 'gerente';
    }
    match /desligamentos/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (perfil()=='gerente'||perfil()=='estagiario');
    }
    match /carteira_futura/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && perfil() == 'gerente';
    }
    match /pedidos/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (perfil() == 'analista' || perfil() == 'gerente');
      // Etapa 2: estagiario pode atualizar (checklist documental). adm_odi entra na próxima etapa (análise documental).
      allow update: if request.auth != null && (perfil() == 'analista' || perfil() == 'gerente' || perfil() == 'estagiario');
      allow delete: if request.auth != null && (perfil() == 'analista' || perfil() == 'gerente');
    }
    // Comentários/avisos por obra
    match /obras/{obraId}/comentarios/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.uid || perfil() == 'gerente'
      );
    }
  }
}
