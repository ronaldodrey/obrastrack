{
  "rewrites": [
    {
      "source": "/((?!.*\\.js$|.*\\.css$|.*\\.ico$|.*\\.png$|.*\\.json$|.*\\.txt$|.*\\.md$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ]
}
